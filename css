/* ═══════════ AURORA — Morning Dashboard ═══════════ */
:root {
  --bg: #0b0d12;
  --bg2: #11141c;
  --card: #151924;
  --card-border: #232a3a;
  --text: #e8ebf2;
  --text2: #9aa3b5;
  --accent: #4f7cff;
  --accent-soft: rgba(79, 124, 255, .12);
  --up: #2ecc71;
  --down: #ff5c6c;
  --radius: 14px;
}
[data-theme="light"] {
  --bg: #f5f6f9;
  --bg2: #eceef3;
  --card: #ffffff;
  --card-border: #e2e6ee;
  --text: #1a1e28;
  --text2: #6b7486;
  --accent: #3b6bef;
  --accent-soft: rgba(59, 107, 239, .09);
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Inter', system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  transition: background .3s, color .3s;
}
body::before {
  content: '';
  position: fixed; inset: 0; z-index: -1;
  background: radial-gradient(ellipse 60% 40% at 50% -10%, var(--accent-soft), transparent 70%);
  pointer-events: none;
}

.hidden { display: none !important; }
.muted { color: var(--text2); }
.small { font-size: 12px; }
.center { text-align: center; }
.mono { font-family: 'JetBrains Mono', monospace; }

/* ─── Topbar ─── */
.topbar {
  position: sticky; top: 0; z-index: 50;
  display: flex; align-items: center; gap: 24px;
  padding: 14px 28px;
  background: color-mix(in srgb, var(--bg) 82%, transparent);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--card-border);
}
.brand { display: flex; align-items: center; gap: 10px; }
.brand-dot {
  width: 12px; height: 12px; border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 12px var(--accent);
}
.brand-name { font-weight: 700; letter-spacing: 3px; font-size: 14px; }
.tabs { display: flex; gap: 4px; flex: 1; overflow-x: auto; }
.tab {
  background: none; border: none; color: var(--text2);
  font: 500 14px 'Inter', sans-serif;
  padding: 8px 16px; border-radius: 10px; cursor: pointer;
  white-space: nowrap; transition: all .2s;
}
.tab:hover { color: var(--text); background: var(--accent-soft); }
.tab.active { color: var(--accent); background: var(--accent-soft); }
.topbar-actions { display: flex; align-items: center; gap: 8px; }
.clock { font-family: 'JetBrains Mono', monospace; font-size: 15px; color: var(--text2); margin-right: 6px; }
.badge {
  display: inline-block; min-width: 18px; padding: 1px 5px;
  background: var(--accent); color: #fff; border-radius: 9px;
  font-size: 11px; text-align: center;
}
.icon-btn {
  background: none; border: 1px solid var(--card-border); color: var(--text2);
  width: 34px; height: 34px; border-radius: 10px; cursor: pointer;
  font-size: 15px; transition: all .2s;
}
.icon-btn:hover { color: var(--accent); border-color: var(--accent); }

/* ─── Layout ─── */
main { max-width: 1080px; margin: 0 auto; padding: 32px 24px 80px; }
.view { display: none; animation: fade .35s ease; }
.view.active { display: block; }
@keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
@media (max-width: 760px) { .grid-2 { grid-template-columns: 1fr; } }

.card {
  background: var(--card);
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
  padding: 20px 22px;
  margin-bottom: 18px;
}
.card-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 14px; gap: 12px;
}
.card-head h2 { font-size: 16px; font-weight: 600; }

.greeting-block { margin-bottom: 26px; }
.greeting-block h1 { font-size: 32px; font-weight: 700; letter-spacing: -.5px; }
.date-line { color: var(--text2); margin-top: 4px; font-size: 15px; }

/* ─── Buttons ─── */
.btn {
  font: 500 13px 'Inter', sans-serif;
  padding: 8px 16px; border-radius: 10px; cursor: pointer;
  border: 1px solid var(--card-border); background: none; color: var(--text);
  transition: all .2s;
}
.btn-accent { background: var(--accent); border-color: var(--accent); color: #fff; }
.btn-accent:hover { filter: brightness(1.12); }
.btn-ghost { border: none; color: var(--accent); padding: 6px 8px; }
.btn-ghost:hover { background: var(--accent-soft); }
.btn.full { width: 100%; margin-top: 10px; }

.chip {
  font: 500 13px 'Inter', sans-serif;
  padding: 7px 16px; border-radius: 20px; cursor: pointer;
  border: 1px solid var(--card-border); background: var(--card); color: var(--text2);
  transition: all .2s;
}
.chip:hover { color: var(--text); }
.chip.active { background: var(--accent); border-color: var(--accent); color: #fff; }
.chip.ghost { border: none; background: none; }
.filter-bar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }

/* ─── News ─── */
.news-item {
  display: block; padding: 16px 18px;
  background: var(--card); border: 1px solid var(--card-border);
  border-radius: var(--radius); margin-bottom: 10px;
  transition: border-color .2s, transform .15s;
}
.news-item:hover { border-color: var(--accent); transform: translateX(3px); }
.news-item .meta {
  display: flex; gap: 10px; align-items: center; margin-bottom: 6px;
  font-size: 12px; color: var(--text2);
}
.src-tag {
  font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 6px;
  background: var(--accent-soft); color: var(--accent);
}
.src-tag.heise { background: rgba(255,150,60,.12); color: #ff9b45; }
.cat-tag { font-size: 11px; padding: 2px 8px; border-radius: 6px; background: var(--bg2); color: var(--text2); }
.news-item h3 { font-size: 15px; font-weight: 600; line-height: 1.4; }
.news-item h3 a { color: var(--text); text-decoration: none; }
.news-item h3 a:hover { color: var(--accent); }
.news-item .teaser { font-size: 13px; color: var(--text2); margin-top: 5px; line-height: 1.5; }
.news-actions { margin-top: 8px; display: flex; gap: 8px; }
.news-actions .btn { font-size: 12px; padding: 5px 12px; }

.news-compact .nc-item { padding: 9px 0; border-bottom: 1px solid var(--card-border); }
.news-compact .nc-item:last-child { border: none; }
.news-compact a { color: var(--text); text-decoration: none; font-size: 14px; font-weight: 500; line-height: 1.4; }
.news-compact a:hover { color: var(--accent); }
.news-compact .nc-src { font-size: 11px; color: var(--text2); display: block; margin-top: 2px; }

/* ─── Events ─── */
.event-day-label {
  font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;
  color: var(--accent); margin: 16px 0 8px;
}
.event-day-label:first-child { margin-top: 0; }
.event-item {
  display: flex; gap: 14px; align-items: baseline;
  padding: 9px 0; border-bottom: 1px solid var(--card-border);
}
.event-item:last-child { border: none; }
.event-time {
  font-family: 'JetBrains Mono', monospace; font-size: 13px;
  color: var(--text2); min-width: 48px;
}
.event-time.allday { color: var(--accent); font-size: 12px; }
.event-title { font-size: 14px; font-weight: 500; }
.event-title.birthday::before { content: '🎂 '; }
.event-title.holiday::before { content: '🇩🇪 '; }

/* ─── KI-Briefing ─── */
.ai-card { border-color: color-mix(in srgb, var(--accent) 35%, var(--card-border)); }
.ai-output { font-size: 14.5px; line-height: 1.7; }
.ai-output p { margin-bottom: 10px; }
.ai-loading { display: flex; align-items: center; gap: 10px; color: var(--text2); }
.spinner {
  width: 16px; height: 16px; border-radius: 50%;
  border: 2px solid var(--card-border); border-top-color: var(--accent);
  animation: spin .8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ─── TradingView Boxen ─── */
.tv-box { min-height: 220px; }
.tv-box.tall { min-height: 480px; }

/* ─── Fokus-Modus ─── */
#focus-overlay {
  position: fixed; inset: 0; z-index: 100;
  background: var(--bg);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 40px;
  animation: fade .4s ease;
}
.focus-clock {
  font-family: 'JetBrains Mono', monospace;
  font-size: clamp(64px, 15vw, 140px); font-weight: 500;
  letter-spacing: -2px;
  background: linear-gradient(135deg, var(--text), var(--accent));
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.focus-next { max-width: 480px; text-align: center; font-size: 18px; line-height: 1.6; }
.focus-exit { position: fixed; top: 24px; right: 24px; }

/* ─── Einstellungen ─── */
#settings-overlay {
  position: fixed; inset: 0; z-index: 90;
  background: rgba(0,0,0,.5); backdrop-filter: blur(4px);
  display: flex; justify-content: flex-end;
}
.settings-panel {
  width: min(440px, 100%); height: 100%;
  background: var(--bg2); border-left: 1px solid var(--card-border);
  padding: 26px; overflow-y: auto;
  animation: slideIn .3s ease;
}
@keyframes slideIn { from { transform: translateX(60px); opacity: 0; } to { transform: none; opacity: 1; } }
.settings-section { margin-top: 24px; }
.settings-section h3 { font-size: 14px; font-weight: 600; margin-bottom: 10px; color: var(--accent); }
.settings-section label { display: block; font-size: 13px; margin-bottom: 6px; }
.settings-section input[type=text], .settings-section input[type=password] {
  width: 100%; padding: 10px 12px; border-radius: 10px;
  border: 1px solid var(--card-border); background: var(--card); color: var(--text);
  font: 400 14px 'Inter', sans-serif; margin-bottom: 6px;
}
.settings-section input:focus { outline: none; border-color: var(--accent); }
.settings-section .row { display: flex; align-items: center; gap: 8px; }

/* ─── Obsidian ─── */
.obs-note { padding: 10px 0; border-bottom: 1px solid var(--card-border); font-size: 14px; }
.obs-note:last-child { border: none; }
.obs-note .obs-name { font-weight: 600; }
.obs-note pre {
  font: 400 13px/1.6 'Inter', sans-serif; white-space: pre-wrap;
  color: var(--text2); margin-top: 6px;
}

/* ─── Mobile ─── */
@media (max-width: 640px) {
  .topbar { flex-wrap: wrap; gap: 10px; padding: 12px 16px; }
  .tabs { order: 3; width: 100%; }
  main { padding: 22px 14px 60px; }
  .greeting-block h1 { font-size: 26px; }
  .clock { display: none; }
}
